#!/bin/bash
set -euo pipefail

readonly ESP=/boot
readonly KERNEL=/boot/vmlinuz-linux-macpro61
readonly INITRAMFS=/boot/initramfs-linux-macpro61.img
readonly LOADER_CONF=/boot/loader/loader.conf
readonly LOADER_ENTRY=/boot/loader/entries/macpro61.conf
readonly ROLLBACK_DIR=/var/lib/macpro61-support/rollback
readonly KERNEL_ENTRY=/vmlinuz-linux-macpro61
readonly INITRAMFS_ENTRY=/initramfs-linux-macpro61.img
readonly SYSTEMD_BOOT_EFI=/boot/EFI/systemd/systemd-bootx64.efi
readonly SYSTEMD_BOOT_FALLBACK=/boot/EFI/BOOT/BOOTX64.EFI

die() {
    printf 'macpro61-bootctl: %s\n' "$*" >&2
    exit 1
}

root_only() {
    (( EUID == 0 )) || die 'this command must be run as root'
}

require_esp() {
    [[ -d $ESP ]] || die "$ESP does not exist"
    local mount_info fstype options actual_source fstab_source
    mount_info=$(findmnt -rn -M "$ESP" -o FSTYPE,OPTIONS 2>/dev/null) || die "$ESP is not a mounted ESP"
    read -r fstype options <<< "$mount_info"
    [[ $fstype == vfat ]] || die "$ESP is mounted as $fstype, not vfat"
    [[ ,$options, == *,rw,* ]] || die "$ESP is not mounted read-write"

    actual_source=$(findmnt -rn -M "$ESP" --evaluate -o SOURCE 2>/dev/null) || die "cannot determine the mounted source for $ESP"
    [[ -n $actual_source ]] || die "$ESP has no mounted source"
    while IFS= read -r fstab_source; do
        [[ -n $fstab_source ]] || continue
        if [[ $(readlink -f -- "$actual_source") == "$(readlink -f -- "$fstab_source")" ]]; then
            return 0
        fi
    done < <(findmnt --fstab --evaluate --noheadings --output SOURCE --mountpoint "$ESP" 2>/dev/null || true)
    die 'the mounted /boot ESP does not match an actual /boot entry in /etc/fstab'
}

free_bytes() {
    local line available
    line=$(df -P -B1 -- "$ESP" | { read -r; read -r line; printf '%s\n' "$line"; }) || return 1
    read -r _ _ _ available _ _ <<< "$line"
    [[ $available =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$available"
}

require_kernel_space() {
    [[ -r $KERNEL && -s $KERNEL ]] || die "missing existing $KERNEL"
    [[ -r $INITRAMFS && -s $INITRAMFS ]] || die "missing existing $INITRAMFS"

    local kernel_size initramfs_size required available
    kernel_size=$(stat -c %s -- "$KERNEL") || die "cannot stat $KERNEL"
    initramfs_size=$(stat -c %s -- "$INITRAMFS") || die "cannot stat $INITRAMFS"
    required=$(( (kernel_size + initramfs_size) * 2 + 64 * 1024 * 1024 ))
    available=$(free_bytes) || die "cannot determine free space on $ESP"
    (( available >= required )) || die "insufficient free space on $ESP (need $required bytes, have $available)"
}

guard() {
    if ! pacman -Q linux-macpro61 >/dev/null 2>&1; then
        return 0
    fi
    require_esp
    require_kernel_space
}

root_partuuid() {
    local root_source root_type partuuid
    root_source=$(findmnt -rn -M / -o SOURCE 2>/dev/null) || die 'cannot determine the filesystem mounted at /'
    [[ -n $root_source ]] || die 'the filesystem mounted at / has no source'
    root_type=$(lsblk -dnro TYPE -- "$root_source" 2>/dev/null) || die "cannot inspect root source $root_source"
    [[ $root_type == part ]] || die "root source $root_source is not a plain partition"
    partuuid=$(lsblk -dnro PARTUUID -- "$root_source" 2>/dev/null) || die "cannot derive PARTUUID for $root_source"
    [[ $partuuid =~ ^[[:alnum:]-]+$ ]] || die "root partition $root_source has no usable PARTUUID"
    printf '%s\n' "$partuuid"
}

atomic_file() {
    local destination=$1 mode=$2 content=$3 temporary
    temporary=$(mktemp "${destination}.tmp.XXXXXX") || die "cannot create temporary $destination"
    printf '%b\n' "$content" > "$temporary" || { rm -f -- "$temporary"; die "cannot write temporary $destination"; }
    chmod "$mode" "$temporary" || { rm -f -- "$temporary"; die "cannot set mode on temporary $destination"; }
    mv -f -- "$temporary" "$destination" || { rm -f -- "$temporary"; die "cannot install $destination"; }
}

finalize() {
    require_esp
    [[ -s $KERNEL ]] || die "missing $KERNEL"
    [[ -s $INITRAMFS ]] || die "missing $INITRAMFS"

    local partuuid
    partuuid=$(root_partuuid)
    mkdir -p -- "${LOADER_CONF%/*}" "${LOADER_ENTRY%/*}" || die 'cannot create systemd-boot loader directories'
    bootctl --esp-path="$ESP" --variables=no install || die 'systemd-boot installation failed'

    atomic_file "$LOADER_CONF" 0644 $'default macpro61.conf\ntimeout 5\neditor no'
    atomic_file "$LOADER_ENTRY" 0644 "title Mac Pro 6,1\nlinux $KERNEL_ENTRY\ninitrd $INITRAMFS_ENTRY\noptions root=PARTUUID=$partuuid rw amdgpu.si_support=1 radeon.si_support=0 amdgpu.dc=0 acpi_mask_gpe=0x16"
    verify
}

package_version() {
    pacman -Q --qf '%v' linux-macpro61 2>/dev/null | {
        read -r version
        [[ -n $version ]] || exit 1
        printf '%s\n' "$version"
    }
}

package_metadata() {
    pacman -Qp --info -- "$1" 2>/dev/null
}

metadata_value() {
    local key=$1 line value
    while IFS= read -r line; do
        case $line in
            "$key"*)
                value=${line#*:}
                value=${value#"${value%%[![:space:]]*}"}
                printf '%s\n' "$value"
                return 0
                ;;
        esac
    done
    return 1
}

validate_kernel_archive() {
    local archive=$1 expected_version metadata name version architecture
    [[ -f $archive && -r $archive ]] || die "kernel archive is not readable: $archive"
    expected_version=$(package_version) || die 'linux-macpro61 is not installed or its version is unavailable'
    metadata=$(package_metadata "$archive") || die "cannot read pacman metadata from $archive"
    name=$(printf '%s\n' "$metadata" | metadata_value Name) || die "kernel archive has no package name: $archive"
    version=$(printf '%s\n' "$metadata" | metadata_value Version) || die "kernel archive has no package version: $archive"
    architecture=$(printf '%s\n' "$metadata" | metadata_value Architecture) || die "kernel archive has no package architecture: $archive"
    [[ $name == linux-macpro61 ]] || die "kernel archive is for $name, not linux-macpro61"
    [[ $version == "$expected_version" ]] || die "kernel archive version $version does not match installed linux-macpro61 $expected_version"
    [[ $architecture == x86_64 ]] || die "kernel archive architecture is $architecture, not x86_64"
}

validate_rollback_checksum() {
    local archive=$1 name=${1##*/} checksum_file expected_digest checksum_name extra actual_digest
    checksum_file="$archive.sha256"
    [[ -s $checksum_file ]] || die "rollback checksum is missing: $checksum_file"

    local -a checksum_lines
    mapfile -t checksum_lines < "$checksum_file" || die "cannot read rollback checksum: $checksum_file"
    (( ${#checksum_lines[@]} == 1 )) || die "rollback checksum is ambiguous: $checksum_file"
    read -r expected_digest checksum_name extra <<< "${checksum_lines[0]}"
    [[ -z ${extra:-} ]] || die "rollback checksum has unexpected data: $checksum_file"
    [[ $checksum_name == "$name" ]] || die "rollback checksum does not name $name"
    [[ $expected_digest =~ ^[[:xdigit:]]{64}$ ]] || die "rollback checksum is invalid: $checksum_file"

    actual_digest=$(sha256sum -- "$archive") || die "cannot checksum rollback archive: $archive"
    actual_digest=${actual_digest%% *}
    [[ ${expected_digest,,} == ${actual_digest,,} ]] || die "rollback checksum failed: $archive"
}

install_rollback_archive() {
    local source=$1 destination temporary checksum_temporary digest name
    name=${source##*/}
    [[ $name == linux-macpro61-*.pkg.tar.* ]] || die "invalid linux-macpro61 archive name: $name"
    mkdir -p -- "$ROLLBACK_DIR" || die "cannot create $ROLLBACK_DIR"
    destination="$ROLLBACK_DIR/$name"
    temporary=$(mktemp "$ROLLBACK_DIR/.archive.XXXXXX") || die 'cannot create rollback temporary file'
    checksum_temporary=$(mktemp "$ROLLBACK_DIR/.sha256.XXXXXX") || {
        rm -f -- "$temporary"
        die 'cannot create rollback checksum temporary file'
    }
    if ! cp -- "$source" "$temporary"; then
        rm -f -- "$temporary" "$checksum_temporary"
        die 'cannot copy the rollback archive'
    fi
    digest=$(sha256sum -- "$temporary") || {
        rm -f -- "$temporary" "$checksum_temporary"
        die 'cannot checksum the rollback archive'
    }
    digest=${digest%% *}
    printf '%s  %s\n' "$digest" "$name" > "$checksum_temporary" || {
        rm -f -- "$temporary" "$checksum_temporary"
        die 'cannot write the rollback checksum'
    }
    mv -f -- "$temporary" "$destination" || {
        rm -f -- "$temporary" "$checksum_temporary"
        die 'cannot install the rollback archive'
    }
    mv -f -- "$checksum_temporary" "$destination.sha256" || {
        rm -f -- "$checksum_temporary"
        die 'cannot install the rollback checksum'
    }
}

preserve_rollback() {
    local installed_version metadata candidate candidate_name selected=''
    installed_version=$(package_version) || die 'linux-macpro61 is not installed or its version is unavailable'

    shopt -s nullglob
    local archives=(/var/cache/pacman/pkg/linux-macpro61-*.pkg.tar.*)
    shopt -u nullglob
    local -a matching_cache=()
    for candidate in "${archives[@]}"; do
        metadata=$(package_metadata "$candidate") || continue
        [[ $(printf '%s\n' "$metadata" | metadata_value Name) == linux-macpro61 ]] || continue
        [[ $(printf '%s\n' "$metadata" | metadata_value Version) == "$installed_version" ]] || continue
        candidate_name=$(printf '%s\n' "$metadata" | metadata_value Architecture) || continue
        [[ $candidate_name == x86_64 ]] || continue
        matching_cache+=("$candidate")
    done
    if (( ${#matching_cache[@]} > 1 )); then
        die "multiple linux-macpro61-$installed_version archives are available in /var/cache/pacman/pkg"
    elif (( ${#matching_cache[@]} == 1 )); then
        selected=${matching_cache[0]}
        install_rollback_archive "$selected"
        return 0
    fi

    local -a seeded=()
    if [[ -d $ROLLBACK_DIR ]]; then
        shopt -s nullglob
        for candidate in "$ROLLBACK_DIR"/linux-macpro61-*.pkg.tar.*; do
            [[ -f $candidate && $candidate != *.sha256 ]] || continue
            seeded+=("$candidate")
        done
        shopt -u nullglob
    fi
    (( ${#seeded[@]} > 0 )) || die "no validated linux-macpro61-$installed_version archive is available in /var/cache/pacman/pkg or $ROLLBACK_DIR"
    (( ${#seeded[@]} == 1 )) || die "multiple seeded linux-macpro61 rollback archives are ambiguous in $ROLLBACK_DIR"

    selected=${seeded[0]}
    validate_rollback_checksum "$selected"
    validate_kernel_archive "$selected"

    install_rollback_archive "$selected"
}

seed_rollback() {
    local archive=${1:-}
    [[ -n $archive ]] || die 'seed-rollback requires a local kernel archive'
    validate_kernel_archive "$archive"
    install_rollback_archive "$archive"
}

entry_has_line() {
    local expected=$1 line
    while IFS= read -r line; do
        [[ $line == "$expected" ]] && return 0
    done < "$LOADER_ENTRY"
    return 1
}

entry_has_option() {
    local option=$1 line
    while IFS= read -r line; do
        [[ $line == options\ * && " $line " == *" $option "* ]] && return 0
    done < "$LOADER_ENTRY"
    return 1
}

loader_default_is_macpro61() {
    local line found=0
    while IFS= read -r line; do
        [[ $line == \#* || -z $line ]] && continue
        if [[ $line == default\ * ]]; then
            [[ $line == 'default macpro61.conf' ]] || return 1
            found=1
        fi
    done < "$LOADER_CONF"
    (( found ))
}

entry_root_matches() {
    local expected=$1 line option root='' found=0
    local -a options
    while IFS= read -r line; do
        [[ $line == options\ * ]] || continue
        read -r -a options <<< "$line"
        for option in "${options[@]:1}"; do
            case $option in
                root=PARTUUID=*)
                    (( found == 0 )) || return 1
                    root=${option#root=PARTUUID=}
                    [[ $root == "$expected" ]] || return 1
                    found=1
                    ;;
            esac
        done
    done < "$LOADER_ENTRY"
    (( found ))
}

package_module_image() {
    local path image='' package_files
    package_files=$(pacman -Qlq linux-macpro61 2>/dev/null) || die 'cannot list linux-macpro61 package files'
    while IFS= read -r path; do
        case $path in
            /usr/lib/modules/*/vmlinuz)
                [[ -z $image ]] || die 'linux-macpro61 has multiple module kernel images'
                image=$path
                ;;
        esac
    done <<< "$package_files"
    [[ -n $image && -r $image && -s $image ]] || die 'linux-macpro61 module kernel image is unavailable'
    printf '%s\n' "$image"
}

require_rollback() {
    [[ -d $ROLLBACK_DIR ]] || die "missing rollback directory $ROLLBACK_DIR"
    local archive metadata name architecture valid=0
    shopt -s nullglob
    local archives=("$ROLLBACK_DIR"/linux-macpro61-*.pkg.tar.*)
    shopt -u nullglob
    local -a filtered_archives=()
    for archive in "${archives[@]}"; do
        [[ $archive == *.sha256 ]] && continue
        filtered_archives+=("$archive")
    done
    archives=("${filtered_archives[@]}")
    (( ${#archives[@]} > 0 )) || die 'no rollback linux-macpro61 archive is available'
    for archive in "${archives[@]}"; do
        [[ -s $archive ]] || die "rollback archive is empty: $archive"
        [[ -s $archive.sha256 ]] || die "rollback checksum is missing: $archive.sha256"
        (cd -- "$ROLLBACK_DIR" && sha256sum --check --status -- "${archive##*/}.sha256") || die "rollback checksum failed: $archive"
        metadata=$(package_metadata "$archive") || die "cannot read rollback metadata: $archive"
        name=$(printf '%s\n' "$metadata" | metadata_value Name) || die "rollback archive has no package name: $archive"
        architecture=$(printf '%s\n' "$metadata" | metadata_value Architecture) || die "rollback archive has no package architecture: $archive"
        [[ $name == linux-macpro61 ]] || die "rollback archive is for $name, not linux-macpro61"
        [[ $architecture == x86_64 ]] || die "rollback archive architecture is $architecture, not x86_64"
        valid=1
    done
    (( valid )) || die 'no valid linux-macpro61 rollback archive is available'
}

verify() {
    require_esp
    [[ -s $KERNEL ]] || die "missing or empty $KERNEL"
    [[ -s $INITRAMFS ]] || die "missing or empty $INITRAMFS"
    require_rollback
    local expected_partuuid module_image
    expected_partuuid=$(root_partuuid)
    module_image=$(package_module_image)
    cmp -s -- "$KERNEL" "$module_image" || die "$KERNEL does not match the installed linux-macpro61 module image"
    [[ -s $LOADER_CONF ]] || die "missing or empty $LOADER_CONF"
    loader_default_is_macpro61 || die 'loader.conf default is not macpro61.conf'
    [[ -s $LOADER_ENTRY ]] || die "missing or empty $LOADER_ENTRY"
    entry_has_line "linux $KERNEL_ENTRY" || die 'loader entry does not reference the custom kernel'
    entry_has_line "initrd $INITRAMFS_ENTRY" || die 'loader entry does not reference the custom initramfs'
    entry_root_matches "$expected_partuuid" || die 'loader entry root PARTUUID does not match the current direct-partition root'
    for option in \
        'amdgpu.si_support=1' \
        'radeon.si_support=0' \
        'amdgpu.dc=0' \
        'acpi_mask_gpe=0x16'; do
        entry_has_option "$option" || die "loader entry is missing kernel option $option"
    done

    bootctl --esp-path="$ESP" --variables=no update || die 'systemd-boot verification/update failed'
    [[ -s $SYSTEMD_BOOT_EFI ]] || die 'systemd-bootx64.efi is not installed on the ESP'
    [[ -s $SYSTEMD_BOOT_FALLBACK ]] || die 'BOOTX64.EFI fallback is not installed on the ESP'
}

main() {
    root_only
    case ${1:-} in
        guard) (( $# == 1 )) || die 'guard takes no arguments'; guard ;;
        finalize) (( $# == 1 )) || die 'finalize takes no arguments'; finalize ;;
        verify) (( $# == 1 )) || die 'verify takes no arguments'; verify ;;
        preserve-rollback) (( $# == 1 )) || die 'preserve-rollback takes no arguments'; preserve_rollback ;;
        seed-rollback) (( $# == 2 )) || die 'seed-rollback takes one local kernel archive argument'; seed_rollback "$2" ;;
        *) die 'usage: macpro61-bootctl {guard|finalize|verify|preserve-rollback|seed-rollback ARCHIVE}' ;;
    esac
}

main "$@"
